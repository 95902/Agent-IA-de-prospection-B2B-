# =============================================================================
# .env.example — Agent IA de Prospection B2B (multi-secteurs)
# =============================================================================
# Ce fichier liste TOUTES les variables d'environnement nécessaires au pipeline.
# Il est versionné sans aucune valeur secrète. Chaque développeur copie ce
# fichier en `.env` et renseigne ses propres clés.
#
#   cp .env.example .env
#
# ⚠️ Ne JAMAIS committer de vraies clés dans .env. Vérifier que .env est bien
# dans .gitignore. Les valeurs ci-dessous sont des exemples / placeholders.
#
# Référence : docs/ARCHITECTURE.md (section « Variables d'environnement »)
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL 16
# -----------------------------------------------------------------------------
POSTGRES_DB=prospection_b2b
POSTGRES_USER=scraper
POSTGRES_PASSWORD=changeme_postgres
# 'localhost' en local hors Docker, 'postgres' depuis un container du compose
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# -----------------------------------------------------------------------------
# Qdrant (vectoriel)
# -----------------------------------------------------------------------------
QDRANT_API_KEY=changeme_qdrant
# 'localhost' en local hors Docker, 'qdrant' depuis un container du compose
QDRANT_HOST=localhost
QDRANT_PORT=6333

# -----------------------------------------------------------------------------
# Ollama (embeddings locaux sur CPU)
# -----------------------------------------------------------------------------
OLLAMA_HOST=localhost
OLLAMA_PORT=11434
# Modèle d'embedding utilisé pour les vecteurs prospects & ICP (768 dims)
OLLAMA_EMBED_MODEL=nomic-embed-text

# -----------------------------------------------------------------------------
# LLM Claude (scoring) & observabilité LangSmith
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
# Modèle Claude utilisé pour le scoring — DOIT rester configurable ici et
# n'être JAMAIS codé en dur dans les prompts (voir CLAUDE.md + docs/SCORING.md).
CLAUDE_SCORING_MODEL=claude-sonnet-5
LANGCHAIN_API_KEY=ls__...
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=prospection-b2b

# -----------------------------------------------------------------------------
# APIs de collecte / enrichissement
# -----------------------------------------------------------------------------

# Sirene INSEE — https://api.insee.fr (endpoint entreprises/sirene/V3.11/siret)
# Clé gratuite, rate limit ~30 req/min
INSEE_API_KEY=

# Tavily — https://tavily.com (1000 requêtes/mois gratuites)
TAVILY_API_KEY=tvly-...

# -----------------------------------------------------------------------------
# APIs non utilisées pour le moment (désactivées par défaut)
# -----------------------------------------------------------------------------
# Conformément à la décision Sprint 0 : Bloctel et Dropcontact ne sont PAS
# activés dans l'immédiat. Les variables restent documentées pour la suite
# (aucune valeur à renseigner tant que le service n'est pas intégré).
#
# NB: Bloctel reste une obligation légale avant tout appel prospect
# (docs/LEGAL.md). La désactivation actuelle ne concerne que la collecte de
# clés API / l'intégration ; à ré-activer avant la phase d'appel.
#
# BLOCTEL_API_KEY=                # https://www.bloctel.gouv.fr
# DROPCONTACT_API_KEY=            # https://dropcontact.com (24€/mois)

# -----------------------------------------------------------------------------
# Paramètres de campagne — valeurs d'EXEMPLE uniquement
# -----------------------------------------------------------------------------
# En production, ces critères proviennent de la table `criteres_ciblage` du
# client/de la campagne (voir models/prospect.py + graph/state.py), jamais de
# variables d'environnement globales. Ces defaults ne servent qu'aux runs
# `--dry-run` en local sans client configuré.
TARGET_DEPTS=75,92,93,94
TARGET_NAF=4520Z,4511Z,4531Z,4532Z
MAX_PROSPECTS=500